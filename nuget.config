<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- ServiceKit.Net.Eventing.PolyPersist is the one project here that depends on PolyPersist,
         which is built from the sibling repository into this feed. Everything else in SrvKit still
         restores from nuget.org alone. -->
    <add key="LocalDevFeed" value="./../LocalDevNugetFeed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="LocalDevFeed">
      <package pattern="PolyPersist.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
